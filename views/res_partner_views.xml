<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_ogi" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.ogi</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_approve_phone_change" string="Approve Phone Change" type="object" class="btn-success" invisible="not pending_phone" groups="ogi_transit.group_ogi_gerant,ogi_transit.group_ogi_pdg,ogi_transit.group_ogi_admin"/>
                </header>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                
                <button type="object" name="action_view_ogi_invoices" class="oe_stat_button" icon="fa-pencil-square-o" invisible="contact_type != 'customer'">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="ogi_display_total"/></span>
                        <span class="o_stat_text">Total Invoiced</span>
                    </div>
                </button>

                <button type="object" name="action_view_ogi_bills" class="oe_stat_button" icon="fa-file-text-o" invisible="contact_type == 'customer'">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="ogi_display_total"/></span>
                        <span class="o_stat_text">Total Billed</span>
                    </div>
                </button>

                <button type="object" name="action_view_ogi_receipts" class="oe_stat_button" icon="fa-money">
                    <field name="ogi_receipt_count" widget="statinfo" string="Payments"/>
                </button>

            </xpath>

            <xpath expr="//field[@name='vat']" position="after">
                <field name="contact_type"/>
                <field name="phone_1" required="1"/>
                <field name="phone_2"/>
                
                <field name="pending_phone" placeholder="Propose new number here..."/>
                <field name="old_phone" invisible="not old_phone"/>
                
                <field name="is_freight_forwarder" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_partner_form_inherit_ogi_transit" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.ogi.transit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='internal_notes']" position="before">
                <page string="Transit Balances" name="ogi_transit_deposits">
                    <group>
                        <group>
                            <!-- Customer view -->
                            <field name="deposit_usd"
                                string="Deposit Balance (USD)"
                                invisible="contact_type != 'customer'"/>
                            <field name="deposit_gnf"
                                string="Deposit Balance (GNF)"
                                invisible="contact_type != 'customer'"/>

                            <!-- Freight Forwarder / Other Suppliers -->
                            <field name="supplier_deposit_gnf"
                                string="Supplier Balance (GNF)"
                                invisible="contact_type not in ('freight_forwarder', 'other')"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_partner_form_inherit_ogi_hide_native" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.ogi.hide.native</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.partner_view_buttons"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_view_partner_invoices']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- 1. Add Telephone 1 Column to the Customer List/Popup View -->
    <record id="view_partner_tree_inherit_ogi_phone" model="ir.ui.view">
        <field name="name">res.partner.tree.inherit.ogi.phone</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <!-- Injects the Telephone 1 column right after the First Column (Customer Name) -->
            <xpath expr="//field[1]" position="after">
                <field name="phone_1" string="Telephone 1"/>
            </xpath>
        </field>
    </record>

    <!-- 2. Make Telephone 1 Searchable in the Advanced Search -->
    <record id="view_res_partner_filter_inherit_ogi_phone" model="ir.ui.view">
        <field name="name">res.partner.search.inherit.ogi.phone</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <!-- Adds Telephone 1 to the search bar parameters -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="phone_1" string="Telephone 1" filter_domain="[('phone_1', 'ilike', self)]"/>
            </xpath>
        </field>
    </record>

</odoo>