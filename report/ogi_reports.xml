<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- EXTERNAL INVOICE                                          -->
    <!-- ========================================================= -->
    <record id="action_report_invoice_external" model="ir.actions.report">
        <field name="name">External Invoice</field>
        <field name="model">ogi.transit.invoice</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ogi_transit.report_invoice_external_document</field>
        <field name="report_file">ogi_transit.report_invoice_external_document</field>
        <field name="print_report_name">'Invoice - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_ogi_transit_invoice"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_invoice_external_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <div class="page" style="font-family: 'DejaVu Sans', Arial, sans-serif; color: #333;">

                        <style>
                            .ogi-header { background-color: #165a92; color: white; padding: 40px; }
                            .ogi-title-left { font-size: 24px; font-weight: 900; letter-spacing: 1px; margin-bottom: 40px; }
                            .ogi-title-right { font-size: 14px; font-weight: 800; color: #e65025; text-transform: uppercase; letter-spacing: 2px; text-align: right; margin-bottom: 40px; }
                            .ogi-inv-number { font-size: 36px; font-weight: 700; line-height: 1.2; margin-bottom: 10px; }
                            .ogi-inv-date { font-size: 14px; opacity: 0.8; }
                            
                            .ogi-client-sec { text-align: right; padding: 30px 40px 10px 40px; }
                            .ogi-client-label { font-size: 12px; font-weight: 700; color: #9ca3af; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 5px; }
                            .ogi-client-name { font-size: 18px; font-weight: 700; color: #1f2937; margin-bottom: 2px; }
                            .ogi-client-phone { font-size: 14px; color: #4b5563; margin-bottom: 8px; }
                            .ogi-client-ref { background-color: #f3f4f6; color: #374151; padding: 4px 10px; border-radius: 4px; font-family: monospace; font-size: 12px; display: inline-block; }
                            
                            .ogi-meta-band { background-color: #f4f3ef; padding: 20px 40px; margin-top: 20px; overflow: hidden; clear: both; }
                            .ogi-meta-item { width: 33.33%; float: left; }
                            .ogi-meta-label { font-size: 11px; font-weight: 700; color: #9ca3af; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 5px; }
                            .ogi-meta-value { font-size: 15px; font-weight: 700; color: #1f2937; font-family: monospace; }
                            
                            .ogi-table { width: 100%; border-collapse: collapse; margin-top: 0; }
                            .ogi-table th { color: #9ca3af; font-size: 11px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; padding: 15px 40px; border-bottom: 1px solid #e5e7eb; }
                            .ogi-table td { padding: 25px 40px; border-bottom: 1px solid #e5e7eb; }
                            .ogi-item-title { font-size: 16px; font-weight: 700; color: #1f2937; margin-bottom: 4px; }
                            .ogi-item-sub { font-size: 13px; color: #9ca3af; }
                            .ogi-item-amount { font-size: 16px; font-weight: 700; font-family: monospace; }
                            .ogi-item-currency { font-size: 13px; color: #9ca3af; }
                            
                            .ogi-total-band { background-color: #f4f3ef; padding: 40px; margin-top: 0; }
                            .ogi-total-label { font-size: 18px; font-weight: 800; color: #1f2937; }
                            .ogi-total-amount { font-size: 24px; font-weight: 700; color: #e65025; font-family: monospace; text-align: right; }
                            .ogi-total-currency { font-size: 16px; font-weight: 700; color: #e65025; text-align: right; padding-left: 15px; }
                        </style>

                        <div class="ogi-header">
                            <table style="width: 100%; border: none;">
                                <tr>
                                    <td><p class="ogi-title-left">OGI TRANSIT</p></td>
                                    <td style="text-align: right;"><p class="ogi-title-right">FACTURE</p></td>
                                </tr>
                            </table>
                            <div>
                                <p class="ogi-inv-number"><span t-field="doc.name"/></p>
                                <p class="ogi-inv-date">Date d'&#233;mission : <span t-field="doc.create_date" t-options='{"widget": "date"}'/></p>
                            </div>
                        </div>

                        <div class="ogi-client-sec">
                            <p class="ogi-client-label">CLIENT</p>
                            <p class="ogi-client-name"><span t-field="doc.partner_id.name"/></p>
                            <p class="ogi-client-phone"><span t-field="doc.partner_id.phone_1"/></p>
                            <p class="ogi-client-ref">
                                REF-<t t-esc="str(doc.partner_id.id).zfill(6)"/>
                            </p>
                        </div>

                        <div class="ogi-meta-band">
                            <div class="ogi-meta-item">
                                <p class="ogi-meta-label">LOT</p>
                                <p class="ogi-meta-value"><span t-field="doc.container_id.bl_id.lot_id.name"/></p>
                            </div>
                            <div class="ogi-meta-item" style="text-align: center;">
                                <p class="ogi-meta-label">CONTENEUR</p>
                                <p class="ogi-meta-value"><span t-field="doc.container_id.name"/></p>
                            </div>
                            <div class="ogi-meta-item" style="text-align: right;">
                                <p class="ogi-meta-label">B/L</p>
                                <p class="ogi-meta-value"><span t-field="doc.container_id.bl_id.name"/></p>
                            </div>
                        </div>

                        <table class="ogi-table">
                            <thead>
                                <tr>
                                    <th class="text-start">D&#201;SIGNATION</th>
                                    <th class="text-end">MONTANT</th>
                                    <th class="text-end" style="width: 100px;">DEVISE</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                        <p class="ogi-item-title">Transit / Douane / Fret</p>
                                        <p class="ogi-item-sub"><span t-field="doc.goods_description"/></p>
                                    </td>
                                    <td class="text-end ogi-item-amount">
                                        <t t-if="doc.currency == 'USD' and doc.ins_amount > 0">
                                            <span t-esc="'{0:,.0f}'.format(doc.freight_amount).replace(',', ' ')"/>
                                        </t>
                                        <t t-else="">
                                            <span t-esc="'{0:,.0f}'.format(doc.base_amount).replace(',', ' ')"/>
                                        </t>
                                    </td>
                                    <td class="text-end ogi-item-currency"><span t-field="doc.currency"/></td>
                                </tr>
                                
                                <tr t-if="doc.bgda_amount > 0">
                                    <td>
                                        <p class="ogi-item-title">BGDA</p>
                                        <p class="ogi-item-sub">Bureau Guin&#233;en du Droit d'Auteur</p>
                                    </td>
                                    <td class="text-end ogi-item-amount">
                                        <span t-esc="'{0:,.0f}'.format(doc.bgda_amount).replace(',', ' ')"/>
                                    </td>
                                    <td class="text-end ogi-item-currency"><span t-field="doc.currency"/></td>
                                </tr>

                                <tr t-if="doc.currency == 'USD' and doc.ins_amount > 0">
                                    <td>
                                        <p class="ogi-item-title">Frais d'Inspection</p>
                                        <p class="ogi-item-sub">Inspection conteneur obligatoire</p>
                                    </td>
                                    <td class="text-end ogi-item-amount">
                                        <span t-esc="'{0:,.0f}'.format(doc.ins_amount).replace(',', ' ')"/>
                                    </td>
                                    <td class="text-end ogi-item-currency"><span t-field="doc.currency"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="ogi-total-band">
                            <table style="width: 100%; border: none;">
                                <tr>
                                    <td class="text-start ogi-total-label">TOTAL D&#219;</td>
                                    <td class="text-end ogi-total-amount">
                                        <span t-esc="'{0:,.0f}'.format(doc.amount_total).replace(',', ' ')"/>
                                    </td>
                                    <td class="text-end ogi-total-currency" style="width: 100px;">
                                        <span t-field="doc.currency"/>
                                    </td>
                                </tr>
                            </table>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- ========================================================= -->
    <!-- INTERNAL INVOICE                                          -->
    <!-- ========================================================= -->
    <record id="action_report_invoice_internal" model="ir.actions.report">
        <field name="name">Internal Invoice &amp; CRM</field>
        <field name="model">ogi.transit.invoice</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ogi_transit.report_invoice_internal_document</field>
        <field name="report_file">ogi_transit.report_invoice_internal_document</field>
        <field name="print_report_name">'Internal_Invoice - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_ogi_transit_invoice"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_invoice_internal_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <div class="page" style="font-family: 'DejaVu Sans', Arial, sans-serif; color: #333;">

                        <style>
                            .ogi-header { background-color: #165a92; color: white; padding: 40px; }
                            .ogi-title-left { font-size: 24px; font-weight: 900; letter-spacing: 1px; margin-bottom: 0; }
                            .ogi-title-sub { color: #ff4d4d; margin-top: 0; font-size: 14px; font-weight: 700; }
                            .ogi-inv-number { font-size: 36px; font-weight: 700; line-height: 1.2; margin-bottom: 10px; }
                            .ogi-inv-date { font-size: 14px; opacity: 0.8; display: inline-block; margin-right: 15px; }
                            
                            .ogi-badge-internal { background-color: #e65025; color: white; padding: 5px 12px; border-radius: 4px; font-size: 12px; font-weight: 800; display: inline-block; letter-spacing: 1px; }
                            .ogi-badge-status { background-color: #60a5fa; color: white; padding: 4px 12px; border-radius: 12px; font-size: 11px; font-weight: 700; display: inline-block; text-transform: uppercase; letter-spacing: 1px; vertical-align: middle; }
                            
                            .ogi-client-sec { text-align: right; padding: 30px 40px 10px 40px; }
                            .ogi-client-label { font-size: 14px; font-weight: 700; color: #9ca3af; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 5px; }
                            .ogi-client-name { font-size: 18px; font-weight: 700; color: #1f2937; margin-bottom: 2px; }
                            .ogi-client-phone { font-size: 14px; color: #4b5563; margin-bottom: 8px; }
                            .ogi-client-ref { background-color: #f3f4f6; color: #374151; padding: 4px 10px; border-radius: 4px; font-family: monospace; font-size: 12px; display: inline-block; }
                            
                            .ogi-meta-band { background-color: #f4f3ef; padding: 20px 40px; margin-top: 20px; overflow: hidden; clear: both; }
                            .ogi-meta-item { width: 33.33%; float: left; }
                            .ogi-meta-label { font-size: 13px; font-weight: 700; color: #9ca3af; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 5px; }
                            .ogi-meta-value { font-size: 16px; font-weight: 700; color: #1f2937; font-family: monospace; }
                            
                            .ogi-table { width: 100%; border-collapse: collapse; margin-top: 0; }
                            .ogi-table th { color: #9ca3af; font-size: 11px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; padding: 15px 40px; border-bottom: 1px solid #e5e7eb; }
                            .ogi-table td { padding: 25px 40px; border-bottom: 1px solid #e5e7eb; }
                            .ogi-item-title { font-size: 16px; font-weight: 700; color: #1f2937; margin-bottom: 4px; }
                            .ogi-item-sub { font-size: 14px; color: #9ca3af; }
                            .ogi-item-amount { font-size: 16px; font-weight: 700; font-family: monospace; }
                            .ogi-item-currency { font-size: 14px; color: #9ca3af; }
                            
                            .ogi-total-band { background-color: #f4f3ef; padding: 40px; margin-top: 0; border-bottom: 1px solid #e5e7eb; }
                            .ogi-total-label { font-size: 18px; font-weight: 800; color: #1f2937; }
                            .ogi-total-amount { font-size: 24px; font-weight: 700; color: #e65025; font-family: monospace; text-align: right; }
                            .ogi-total-currency { font-size: 16px; font-weight: 700; color: #e65025; text-align: right; padding-left: 15px; }
                            
                            .ogi-account-status { background-color: #f4f3ef; padding: 30px 40px; }
                            .ogi-account-title { font-size: 14px; font-weight: 700; color: #9ca3af; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 25px; }
                            .ogi-account-row { margin-bottom: 20px; font-size: 14px; overflow: hidden; clear: both; }
                            .ogi-account-row > div:first-child { float: left; }
                            .ogi-account-row > div:last-child { float: right; text-align: right; }
                            .ogi-account-val { font-family: monospace; font-weight: 700; font-size: 16px; }
                            .ogi-account-currency { color: #9ca3af; font-size: 14px; margin-left: 10px; }
                        </style>

                        <div class="ogi-header">
                            <table style="width: 100%; border: none;">
                                <tr>
                                    <td>
                                        <p class="ogi-title-left">OGI TRANSIT</p>
                                        <p class="ogi-title-sub">FACTURE</p>
                                    </td>
                                    <td style="text-align: right; vertical-align: top;">
                                        <div class="ogi-badge-internal">INTERNE</div>
                                    </td>
                                </tr>
                            </table>
                            <div>
                                <p class="ogi-inv-number"><span t-field="doc.name"/></p>
                                <p class="ogi-inv-date">Date d'&#233;mission : <span t-field="doc.create_date" t-options='{"widget": "date"}'/></p>
                                <div class="ogi-badge-status">
                                    <t t-if="doc.state == 'draft'">Brouillon</t>
                                    <t t-elif="doc.state == 'issued'">&#201;mise</t>
                                    <t t-elif="doc.state == 'partial'">Partielle</t>
                                    <t t-elif="doc.state == 'paid'">Pay&#233;e</t>
                                    <t t-elif="doc.state == 'canceled'">Annul&#233;e</t>
                                </div>
                            </div>
                        </div>

                        <div class="ogi-client-sec">
                            <p class="ogi-client-label">CLIENT</p>
                            <p class="ogi-client-name"><span t-field="doc.partner_id.name"/></p>
                            <p class="ogi-client-phone"><span t-field="doc.partner_id.phone_1"/></p>
                            <p class="ogi-client-ref">
                                REF-<t t-esc="str(doc.partner_id.id).zfill(6)"/>
                            </p>
                        </div>

                        <div class="ogi-meta-band">
                            <div class="ogi-meta-item">
                                <p class="ogi-meta-label">LOT</p>
                                <p class="ogi-meta-value"><span t-field="doc.container_id.bl_id.lot_id.name"/></p>
                            </div>
                            <div class="ogi-meta-item" style="text-align: center;">
                                <p class="ogi-meta-label">CONTENEUR</p>
                                <p class="ogi-meta-value"><span t-field="doc.container_id.name"/></p>
                            </div>
                            <div class="ogi-meta-item" style="text-align: right;">
                                <p class="ogi-meta-label">B/L</p>
                                <p class="ogi-meta-value"><span t-field="doc.container_id.bl_id.name"/></p>
                            </div>
                        </div>

                        <table class="ogi-table">
                            <thead>
                                <tr>
                                    <th class="text-start">D&#201;SIGNATION</th>
                                    <th class="text-end">MONTANT</th>
                                    <th class="text-end" style="width: 100px;">DEVISE</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                        <p class="ogi-item-title">Transit / Douane / Fret</p>
                                        <p class="ogi-item-sub"><span t-field="doc.goods_description"/></p>
                                    </td>
                                    <td class="text-end ogi-item-amount">
                                        <t t-if="doc.currency == 'USD' and doc.ins_amount > 0">
                                            <span t-esc="'{0:,.0f}'.format(doc.freight_amount).replace(',', ' ')"/>
                                        </t>
                                        <t t-else="">
                                            <span t-esc="'{0:,.0f}'.format(doc.base_amount).replace(',', ' ')"/>
                                        </t>
                                    </td>
                                    <td class="text-end ogi-item-currency"><span t-field="doc.currency"/></td>
                                </tr>
                                
                                <tr t-if="doc.bgda_amount > 0">
                                    <td>
                                        <p class="ogi-item-title">BGDA</p>
                                        <p class="ogi-item-sub">Bureau Guin&#233;en du Droit d'Auteur</p>
                                    </td>
                                    <td class="text-end ogi-item-amount">
                                        <span t-esc="'{0:,.0f}'.format(doc.bgda_amount).replace(',', ' ')"/>
                                    </td>
                                    <td class="text-end ogi-item-currency"><span t-field="doc.currency"/></td>
                                </tr>

                                <tr t-if="doc.currency == 'USD' and doc.ins_amount > 0">
                                    <td>
                                        <p class="ogi-item-title">Frais d'Inspection</p>
                                        <p class="ogi-item-sub">Inspection conteneur obligatoire</p>
                                    </td>
                                    <td class="text-end ogi-item-amount">
                                        <span t-esc="'{0:,.0f}'.format(doc.ins_amount).replace(',', ' ')"/>
                                    </td>
                                    <td class="text-end ogi-item-currency"><span t-field="doc.currency"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="ogi-total-band">
                            <table style="width: 100%; border: none;">
                                <tr>
                                    <td class="text-start ogi-total-label">TOTAL D&#219;</td>
                                    <td class="text-end ogi-total-amount">
                                        <span t-esc="'{0:,.0f}'.format(doc.amount_total).replace(',', ' ')"/>
                                    </td>
                                    <td class="text-end ogi-total-currency" style="width: 100px;">
                                        <span t-field="doc.currency"/>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- ACCOUNT STATUS -->
                        <div class="ogi-account-status">
                            <p class="ogi-account-title">&#201;TAT DU COMPTE</p>
                            
                            <div class="ogi-account-row">
                                <div>Total factur&#233;</div>
                                <div>
                                    <span class="ogi-account-val"><t t-esc="'{0:,.0f}'.format(doc.amount_total).replace(',', ' ')"/></span>
                                    <span class="ogi-account-currency"><t t-esc="doc.currency"/></span>
                                </div>
                            </div>
                            
                            <div class="ogi-account-row">
                                <div>Total pay&#233;</div>
                                <div>
                                    <span class="ogi-account-val" style="color: #9ca3af;"><t t-esc="'{0:,.0f}'.format(doc.amount_paid).replace(',', ' ')"/></span>
                                    <span class="ogi-account-currency"><t t-esc="doc.currency"/></span>
                                </div>
                            </div>
                            
                            <div class="ogi-account-row" style="margin-top: 30px; margin-bottom: 0;">
                                <div style="font-weight: 700;">Reste &#224; payer</div>
                                <div>
                                    <span class="ogi-account-val" style="color: #e65025;"><t t-esc="'{0:,.0f}'.format(doc.amount_residual).replace(',', ' ')"/></span>
                                    <span class="ogi-account-currency" style="color: #e65025;"><t t-esc="doc.currency"/></span>
                                </div>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- ========================================================= -->
    <!-- PAYMENT RECEIPT                                           -->
    <!-- ========================================================= -->
    <record id="action_report_receipt" model="ir.actions.report">
        <field name="name">Print Payment Receipt</field>
        <field name="model">ogi.transit.transaction</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ogi_transit.report_receipt_document</field>
        <field name="report_file">ogi_transit.report_receipt_document</field>
        <field name="print_report_name">'Receipt - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_ogi_transit_transaction"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_receipt_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <style>
                        .ogi-receipt { font-family: 'DejaVu Sans', Arial, sans-serif; color: #333; page-break-inside: avoid; }
                        
                        .ogi-header { background-color: #205c95; color: white; padding: 25px 30px; }
                        .ogi-title-left { font-size: 20px; font-weight: 900; margin: 0; letter-spacing: 1px; }
                        .ogi-title-right { font-size: 14px; font-weight: 800; color: #e65025; margin: 0; text-transform: uppercase; letter-spacing: 1px; text-align: right; }
                        .ogi-divider { border-top: 1px solid rgba(255,255,255,0.2); margin: 15px 0; }
                        .ogi-ref { font-size: 24px; font-weight: 700; margin: 0; }
                        .ogi-date { font-size: 12px; opacity: 0.8; margin-top: 3px; }
                        
                        .ogi-amount-sec { padding: 30px 20px; text-align: center; border-left: 1px solid #e5e7eb; border-right: 1px solid #e5e7eb; }
                        .ogi-amount-label { font-size: 11px; font-weight: 700; color: #9ca3af; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 10px; }
                        .ogi-amount-val { font-size: 42px; font-weight: 700; margin: 0; color: #1f2937; letter-spacing: 1px; }
                        .ogi-currency { font-size: 18px; font-weight: 800; color: #059669; margin-top: 5px; margin-bottom: 15px; }
                        .ogi-badge { background-color: #d1fae5; color: #065f46; padding: 6px 15px; border-radius: 20px; font-weight: 700; font-size: 13px; display: inline-block; }
                        
                        .ogi-method-sec { background-color: #f9fafb; padding: 20px; text-align: center; border: 1px solid #e5e7eb; }
                        .ogi-method-title { font-size: 16px; font-weight: 800; margin: 0; color: #1f2937; }
                        .ogi-method-sub { font-size: 12px; color: #6b7280; margin-top: 5px; margin-bottom: 0; }
                        
                        .ogi-details-sec { padding: 25px 30px; border-left: 1px solid #e5e7eb; border-right: 1px solid #e5e7eb; border-bottom: 1px solid #e5e7eb; }
                        .ogi-sec-title { font-size: 11px; font-weight: 800; color: #9ca3af; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 15px; }
                        .ogi-label { font-size: 11px; color: #6b7280; margin: 0 0 2px 0; text-transform: uppercase; }
                        .ogi-value { font-size: 14px; font-weight: 700; color: #1f2937; margin: 0 0 15px 0; }
                    </style>
                    
                    <div class="page ogi-receipt">
                        <div class="ogi-header">
                            <table style="width: 100%; border: none;">
                                <tr>
                                    <td><p class="ogi-title-left">OGI TRANSIT</p></td>
                                    <td style="text-align: right;">
                                        <p class="ogi-title-right">
                                            <t t-if="o.type == 'in'">Re&#231;u de Paiement</t>
                                            <t t-else="">Re&#231;u de D&#233;caissement</t>
                                        </p>
                                    </td>
                                </tr>
                            </table>
                            <div class="ogi-divider"/>
                            <div>
                                <p class="ogi-ref"><span t-field="o.name"/></p>
                                <p class="ogi-date"><span t-field="o.date" t-options='{"widget": "datetime"}'/></p>
                            </div>
                        </div>
                        
                        <div class="ogi-amount-sec">
                            <p class="ogi-amount-label">
                                <t t-if="o.type == 'in'">Montant Encaiss&#233;</t>
                                <t t-else="">Montant D&#233;caiss&#233;</t>
                            </p>
                            <p class="ogi-amount-val">
                                <span t-esc="'{0:,.0f}'.format(o.amount).replace(',', ' ')"/>
                            </p>
                            <p class="ogi-currency">
                                <t t-if="o.cashbox_id"><span t-field="o.cashbox_id.currency"/></t>
                                <t t-else="">GNF/USD</t>
                            </p>
                            <div class="ogi-badge">
                                <t t-if="o.type == 'in'">Facture sold&#233;e</t>
                                <t t-else="">Paiement effectu&#233;</t>
                            </div>
                        </div>
                        
                        <div class="ogi-method-sec">
                            <p class="ogi-method-title">
                                <t t-if="o.cashbox_id"><span t-field="o.cashbox_id.name"/></t>
                                <t t-else="">Customer Deposit Wallet</t>
                            </p>
                            <p class="ogi-method-sub">Esp&#232;ces remises en main propre / Transfert valid&#233; en syst&#232;me</p>
                        </div>
                        
                        <t t-if="o.invoice_id">
                            <div class="ogi-details-sec">
                                <p class="ogi-sec-title">Dossier</p>
                                <table style="width: 100%; border: none;">
                                    <tr>
                                        <td style="width: 50%; vertical-align: top;">
                                            <p class="ogi-label">Conteneur</p>
                                            <p class="ogi-value"><span t-field="o.invoice_id.container_id.name"/></p>
                                            
                                            <p class="ogi-label">Type</p>
                                            <p class="ogi-value">
                                                <span t-if="o.invoice_id.container_id.type == 'lcl_home'">LCL + Home</span>
                                                <span t-elif="o.invoice_id.container_id.type == 'fcl_home'">FCL + Home</span>
                                                <span t-elif="o.invoice_id.container_id.type == 'fcl_awaye'">FCL + Awaye</span>
                                                <span t-if="o.invoice_id.container_id.origin"> &#8226; <t t-esc="str(o.invoice_id.container_id.origin).capitalize()"/></span>
                                            </p>
                                            
                                            <p class="ogi-label">N&#176; FACTURE</p>
                                            <p class="ogi-value" style="margin-bottom: 0;"><span t-field="o.invoice_id.name"/></p>
                                        </td>
                                        <td style="width: 50%; vertical-align: top;">
                                            <p class="ogi-label">B/L</p>
                                            <p class="ogi-value"><span t-field="o.invoice_id.container_id.bl_id.name"/></p>
                                            
                                            <p class="ogi-label">Lot</p>
                                            <p class="ogi-value"><span t-field="o.invoice_id.container_id.bl_id.lot_id.name"/></p>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                            
                            <div class="ogi-details-sec" style="border-top: none;">
                                <p class="ogi-sec-title">Client</p>
                                <table style="width: 100%; border: none;">
                                    <tr>
                                        <td style="width: 50%; vertical-align: top;">
                                            <p class="ogi-label">Nom</p>
                                            <p class="ogi-value" style="margin-bottom: 0;"><span t-field="o.partner_id.name"/></p>
                                        </td>
                                        <td style="width: 50%; vertical-align: top;">
                                            <p class="ogi-label">Mark</p>
                                            <t t-set="pl_lines" t-value="o.invoice_id.container_id.pl_line_ids.filtered(lambda l: l.partner_id.id == o.partner_id.id)"/>
                                            <p class="ogi-value" style="margin-bottom: 0;">
                                                <t t-if="pl_lines"><span t-esc="pl_lines[0].mark"/></t>
                                                <t t-else="">N/A</t>
                                            </p>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="ogi-details-sec">
                                <p class="ogi-sec-title">Dossier / Motif</p>
                                <p class="ogi-label">Motif / R&#233;f&#233;rence de la Transaction</p>
                                <p class="ogi-value" style="margin-bottom: 0;"><span t-field="o.reason"/></p>
                            </div>
                            <div class="ogi-details-sec" style="border-top: none;">
                                <p class="ogi-sec-title">Client / Partenaire</p>
                                <table style="width: 100%; border: none;">
                                    <tr>
                                        <td style="width: 50%; vertical-align: top;">
                                            <p class="ogi-label">Nom</p>
                                            <p class="ogi-value" style="margin-bottom: 0;">
                                                <t t-if="o.partner_id"><span t-field="o.partner_id.name"/></t>
                                                <t t-else="">Transfert Interne / OGI</t>
                                            </p>
                                        </td>
                                        <td style="width: 50%; vertical-align: top;">
                                            <p class="ogi-label">T&#233;l&#233;phone</p>
                                            <p class="ogi-value" style="margin-bottom: 0;">
                                                <t t-if="o.partner_id"><span t-field="o.partner_id.phone_1"/></t>
                                                <t t-else="">N/A</t>
                                            </p>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>